{
  "name": "isl-cnu.github.io",
  "version": "1.0.0",
  "description": "Image System Laboratory (CNU) homepage",
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "data": "node scripts/sync-seminars.mjs && node scripts/check-data.mjs && node scripts/seminar-thumbs.mjs",
    "dev": "npm run data && vitepress dev",
    "build": "npm run data && vitepress build",
    "preview": "vitepress preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview"
  },
  "type": "module",
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "pdfjs-dist": "6.4.299",
    "vitepress": "1.6.4",
    "yaml": "2.9.1"
  },
  "private": true
}
